          "name": "Get_Single_Book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst responseData = pm.response.json();\r\n\r\npm.test(\"Response contains a title\", function () {\r\n    pm.expect(responseData).to.have.property(\"title\");\r\n});\r\n\r\npm.test(\"Response contains an ID\", function () {\r\n    pm.expect(responseData.id).to.eql(1);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
